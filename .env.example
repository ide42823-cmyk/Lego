# Copy this file to `.env` and fill in real values.
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the app bundle.
# NEVER put secrets, private keys, or privileged credentials here.

# One of: development | production | test
EXPO_PUBLIC_APP_ENV=development

# Base URL of the backend API. Leave empty until a backend exists.
EXPO_PUBLIC_API_BASE_URL=

# LiveKit WebSocket URL used to prefill the DEV-ONLY RTC spike screen
# (src/app/dev/rtc-spike.tsx). Leave empty unless you are testing voice.
#   Local server, Android emulator:   ws://10.0.2.2:7880
#   Local server, physical device:    ws://<your-LAN-IP>:7880   (same Wi-Fi)
#   LiveKit Cloud:                    wss://<project>.livekit.cloud
# Never put an API secret or a token here: tokens are short-lived and minted
# per session (see tools/livekit-token.mjs).
EXPO_PUBLIC_LIVEKIT_URL=
